{
  "schema_version": 1,
  "package_roots": [
    "skills/*",
    "hooks",
    "scripts",
    ".github/actions/*",
    ".github/codex-review"
  ],
  "package_change_lines": 400,
  "trust_boundary_paths": [
    ".github/actions/publish-landed-gate/*",
    ".github/actions/skill-review/*",
    ".github/codex-review/*",
    ".github/workflows/*",
    ".herdr/triggers.json",
    "hooks/*",
    "skills/adopt-fork-pr/*",
    "skills/herdr-teamlead/teamlead/assign.py",
    "skills/herdr-teamlead/teamlead/cli.py",
    "skills/herdr-teamlead/teamlead/composition.py",
    "skills/herdr-teamlead/teamlead/engagement.py",
    "skills/herdr-teamlead/teamlead/historical.py",
    "skills/herdr-teamlead/teamlead/qualification.py",
    "skills/herdr-teamlead/teamlead/recovery.py",
    "skills/herdr-teamlead/teamlead/report_delivery.py",
    "skills/herdr-teamlead/teamlead/role_clear.py",
    "skills/herdr-teamlead/teamlead/supervision.py",
    "skills/herdr-teamlead/teamlead/triggers.py",
    "skills/herdr-teamlead/verify-authority.sh",
    "skills/release/dismiss-stale-reviews.sh",
    "skills/release/registry-has-version.sh",
    "skills/release/smart-publish.sh"
  ],
  "cli_spec_paths": [
    "skills/herdr-teamlead/teamlead/*.py"
  ],
  "cli_surface_markers": [
    "add_parser(",
    "add_argument(",
    "raise UsageError(",
    "raise PlanError(",
    "_fail("
  ],
  "user_doc_paths": [
    "README.md",
    "CONTRIBUTING.md",
    "docs/*"
  ]
}
