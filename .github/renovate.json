{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [".github/workflows/*.lock.yml"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/actions/setup-diagnostics/action.yml",
        ".github/workflows/review-codex.yml",
        ".github/workflows/fleet-review.yml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+version=(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+npm install -g pyright@(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?[\\s\\S]*?npm install -g @openai/codex@(?<currentValue>\\S+)"
      ]
    }
  ]
}
