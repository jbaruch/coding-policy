{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboardAutoclose": true,
  "pre-commit": {
    "enabled": true
  },
  "ignorePaths": [".github/workflows/*.lock.yml"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/actions/setup-diagnostics/action.yml",
        ".github/actions/setup-zsh/action.yml",
        ".github/workflows/review-codex.yml",
        ".github/workflows/fleet-review.yml",
        ".github/workflows/review-claude.yml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+version=(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+npm install -g pyright@(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?[\\s\\S]*?npm install -g @openai/codex@(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>npm) depName=(?<depName>@anthropic-ai/claude-code)[\\s\\S]*?npm install -g @anthropic-ai/claude-code@(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "ACR acceptance lane: the upstream FFA gate targets Python 3.12; stay within 3.12.x (see the step's renewal note).",
      "matchFileNames": [
        ".github/workflows/acr-codex-accept.yml"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.13"
    },
    {
      "description": "ACR acceptance lane: bubblewrap is pinned to a Noble (24.04) build; move the runner only together with a bubblewrap re-pin.",
      "matchFileNames": [
        ".github/workflows/acr-codex-accept.yml"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "allowedVersions": "<25"
    },
    {
      "description": "Move the unit-test and publish runners together with the Zsh archive and pin.",
      "matchFileNames": [".github/workflows/tests.yml", ".github/workflows/publish.yml"],
      "matchDepNames": ["ubuntu"],
      "matchCurrentValue": "26.04",
      "allowedVersions": "26.04"
    },
    {
      "matchFileNames": [".github/actions/setup-zsh/action.yml"],
      "matchDatasources": ["deb"],
      "matchDepNames": ["zsh"],
      "registryUrls": [
        "https://archive.ubuntu.com/ubuntu?suite=resolute&components=main&binaryArch=amd64",
        "https://archive.ubuntu.com/ubuntu?suite=resolute-updates&components=main&binaryArch=amd64",
        "https://security.ubuntu.com/ubuntu?suite=resolute-security&components=main&binaryArch=amd64"
      ]
    }
  ]
}
