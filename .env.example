# GitHub Actions secrets and local configuration used in this repo.
# Configure hosted secrets here:
#   https://github.com/jbaruch/coding-policy/settings/secrets/actions

# Required by .github/workflows/publish.yml — Tessl tile publishing.
# Get this from your Tessl account: https://app.tessl.io/
TESSL_TOKEN=

# Required by .github/workflows/review-codex.yml — the Codex CLI policy
# reviewer authenticates with a ChatGPT subscription (no API key). Create the
# token once with `codex login` on a trusted machine, then store the FULL
# contents of ~/.codex/auth.json here (auth_mode "chatgpt", has_refresh_token
# true). See https://learn.chatgpt.com/docs/auth/ci-cd-auth
CODEX_AUTH_JSON=

# .github/workflows/acr-codex-accept.yml (seed step) also reads CODEX_AUTH_JSON:
# the operator has one Codex subscription, so the ACR acceptance lane shares the
# reviewer's session. A refresh during acceptance can rotate it; recover with a
# fresh `codex login` and re-running the gh secret set above.

# Required by .github/workflows/fleet-review.yml — the central fleet reviewer.
# It reuses CODEX_AUTH_JSON (above) and TESSL_TOKEN (above), plus a GitHub App
# (coding-policy-fleet-reviewer; Pull requests RW, Contents RO, Metadata RO,
# installed on every reviewed repo) for the reviewer identity + cross-repo access.
# FLEET_APP_ID is the App's numeric App ID; FLEET_APP_PRIVATE_KEY is the App's
# generated private key (full PEM, BEGIN/END lines included).
FLEET_APP_ID=
FLEET_APP_PRIVATE_KEY=

# Required by review-claude.yml and the fleet quality lane. Create a separate
# private GitHub App named jbaruch-claude-reviewer under this account; install it
# on the reviewed repositories. Permissions: Contents read, Pull requests write,
# Metadata read (automatic); no webhooks or account permissions. The separate
# identity prevents either reviewer's approval from erasing the other's block.
# https://github.com/settings/apps
# Store its numeric App ID and full generated private key (PEM) in this repo's
# Actions secrets page linked above. Neither belongs in a consumer repo.
CLAUDE_REVIEW_APP_ID=
CLAUDE_REVIEW_APP_PRIVATE_KEY=

# Runtime output of the Claude App-token step; the driver verifies its identity.
# Not a secret or an operator-managed variable.
REVIEWER_LOGIN=

# Activation flag for fleet-review.yml — a repo VARIABLE, not a secret (set it at
# https://github.com/jbaruch/coding-policy/settings/variables/actions). The
# workflow stays dormant until this is true.
FLEET_REVIEWER_ENABLED=false

# Activation flag for centrally executing fleet-publish.yml. Keep false until
# its reviewed source and actual App scopes are verified. This is a central
# Actions VARIABLE, never a consumer secret. Publishing reuses TESSL_TOKEN and
# FLEET_APP_ID/FLEET_APP_PRIVATE_KEY above; consumers need no dispatch token.
# The selected token requests Contents write, Pull requests read, Checks read
# and Commit statuses read on the selected consumer only; discovery requests
# Contents, Pull requests, Checks and Commit statuses read. Existing reviewer grants remain unchanged in their own jobs.
FLEET_PUBLISHER_ENABLED=false

# Workflow-generated github.token scoped to the central repository. Used only
# for native evidence readback, selected-run dispatch and the source-owned
# create-only durable ledger jobs. Contents write is job-scoped to that ledger;
# no central source/default-branch write is authorized. Do not set a consumer secret or copy an App/Tessl token into this variable.
FLEET_CENTRAL_TOKEN=

# Required by review-claude.yml and the fleet quality lane. Generate a one-year
# Claude subscription token with `claude setup-token` on a trusted machine,
# then pipe it into `gh secret set CLAUDE_CODE_OAUTH_TOKEN`. Renew before expiry
# or after an authentication failure. Keep it only in this central repo.
# https://code.claude.com/docs/en/authentication#generate-a-long-lived-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional local Herdr round setting; required only when review-package.sh
# omits OUTFILE. Set this yourself to the round's writable reports directory.
# Not a credential or a GitHub Actions secret.
FOREMAN_REPORTS_DIR=

# Herdr supplies these to its native panes. Required for live foreman supervision
# binding and its exact-session Stop check; offline saved-state commands need
# neither. Launch the foreman inside Herdr to obtain them; never guess a pane ID.
# Not credentials or GitHub Actions secrets.
HERDR_ENV=
HERDR_PANE_ID=

# Required locally by .github/codex-accept/contract.py download/verify/consume.
# Reuse existing GitHub CLI authentication with access to jbaruch/coding-policy:
# after `gh auth login`, run `export GH_TOKEN="$(gh auth token)"` in your shell.
# A fine-grained token must select that repository and grant Actions: read
# (Metadata: read is automatic). If needed, configure one at:
# https://github.com/settings/personal-access-tokens/new
# Hosted consume uses github.token with actions: read; no new repository secret
# or Codex API key is needed. Never commit the populated value.
GH_TOKEN=

# Optional local Herdr setting and repo Actions secret: the TypeSafe API key the
# report classifier's Jev adapter reads at runtime
# (skills/herdr-foreman/classify/typesafe_client.py). Get one from the TypeSafe
# console (https://docs.typesafe.ai/api). Unset, the classifier labels nothing
# and every report is read in full, ungated. The key is never logged, echoed in
# errors, or written into a label.
TYPESAFE_API_KEY=
