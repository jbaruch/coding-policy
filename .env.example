# GitHub Actions secrets required by workflows in this repo.
# Configure all of them here:
#   https://github.com/jbaruch/coding-policy/settings/secrets/actions

# Required by .github/workflows/publish.yml — Tessl tile publishing.
# Get this from your Tessl account: https://app.tessl.io/
TESSL_TOKEN=

# Required by .github/workflows/review-openai.md — paired gh-aw PR reviewer,
# OpenAI Codex engine. gh-aw's Codex engine accepts either CODEX_API_KEY or
# OPENAI_API_KEY (OPENAI_API_KEY is used as a fallback when CODEX_API_KEY
# is unset); set at least one.
# Get either from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
CODEX_API_KEY=

# Required by .github/workflows/review-anthropic.md — paired gh-aw PR reviewer,
# Claude Code engine. The Anthropic-family reviewer runs cross-family on any
# openai-authored PR (and skips with a COMMENT on anthropic-authored PRs).
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
