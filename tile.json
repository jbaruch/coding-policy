      "rules": "rules/file-hygiene.md",
      "alwaysApply": true
    },
    "ci-safety": {
      "rules": "rules/ci-safety.md",
      "alwaysApply": true
    },
    "no-secrets": {
      "rules": "rules/no-secrets.md",
      "alwaysApply": true
    },
